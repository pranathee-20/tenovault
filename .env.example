# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Required in production for signing and verifying authentication tokens.
# In development, a random cryptographic secret is automatically generated at startup if omitted.
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"

# DEMO_MODE: Set to 'true' to enable synthetic demo accounts, demo switcher, and demo reset endpoint.
# Set to 'false' in production environments to disable synthetic demo capabilities.
DEMO_MODE="true"
